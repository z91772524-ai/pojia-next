[Unit]
Description=pojia-admin · 破甲统一管理后台 (127.0.0.1:3120)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/pojia-admin
Environment=PA_ROOT=/opt/pojia-admin
Environment=PA_PORT=3120
ExecStart=/usr/bin/python3 /opt/pojia-admin/admin.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
